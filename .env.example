# pulse-metric-studio configuration
# Copy to .env and adjust. Everything here is optional - the app is configurable at runtime.

# ---- Server ----
PORT=4620
HOST=127.0.0.1
# Directory for SQLite database + machine key (defaults to ./data)
PULSE_METRIC_STUDIO_DATA_DIR=./data

# ---- LLM providers ----
# OpenCode is the initial provider. Select an explicit model before using AI features.
PULSE_METRIC_STUDIO_LLM_PROVIDER=opencode

# Amazon Bedrock (AWS-native Converse API).
# Credentials resolve through the standard AWS chain unless overridden here.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional endpoint override for Bedrock-compatible gateways:
# AWS_ENDPOINT_URL_BEDROCK=https://bedrock-gateway.example.com
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# OpenAI-compatible endpoint (direct API key or gateway exposing /chat/completions)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Direct Anthropic API key (optional convenience)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# opencode CLI (no key required). Override binary path if not on PATH.
OPENCODE_BIN=opencode
OPENCODE_MODEL=

# ---- Misc ----
LOG_LEVEL=info
