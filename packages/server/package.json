{
    "name":  "@pulse-metric-studio/server",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch --include ../shared/dist/**/*.js --include ../core/dist/**/*.js --include ../pulse/dist/**/*.js src/index.ts",
                    "build":  "tsc -p tsconfig.json",
                    "test":  "node ../../scripts/run-tests.mjs src",
                    "typecheck":  "tsc --noEmit",
                    "start":  "node dist/index.js"
                },
    "dependencies":  {
                         "@fastify/cors":  "^10.0.1",
                         "@fastify/sensible":  "^6.0.2",
                         "@fastify/static":  "^10.1.3",
                         "@pulse-metric-studio/core":  "*",
                         "@pulse-metric-studio/pulse":  "*",
                         "@pulse-metric-studio/shared":  "*",
                         "dotenv":  "^16.4.7",
                         "fastify":  "^5.2.0"
                     },
    "devDependencies":  {
                            "@types/better-sqlite3":  "^7.6.12",
                            "@types/node":  "^22.10.2",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.7.2"
                        }
}
