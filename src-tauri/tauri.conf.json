{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse Metric Studio",
  "version": "0.1.0",
  "identifier": "com.ahillspace.pulsemetricstudio",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/copy-resources.mjs",
    "frontendDist": "../packages/web/dist"
  },
  "bundle": {
    "active": true,
    "publisher": "ahillspace",
    "copyright": "Copyright © 2026 Andrew Hill",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/server",
      "resources/web",
      "resources/runtime"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
